# Database
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=db
POSTGRES_DB=twitchrewards
POSTGRES_USER=twitchrewards

# SSL (certificados Let's Encrypt / Cloudflare)
SSL_KEY_PATH=
SSL_CERTIFICATE_PATH=

# JWT
JWT_ENCODING_KEY=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION_TIME_IN_SECONDS=86400

# Twitch OAuth
TWITCH_APP_CLIENT_ID=your_twitch_client_id
TWITCH_APP_CLIENT_SECRET=your_twitch_client_secret

# APP
APP_HOST=https://your-node.your-tailnet.ts.net
APP_PORT=443
ENV=prod
